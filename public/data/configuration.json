{
	"settings": {
		"global": {
			"defaultCc": "am.k8s@eni.com",
			"minNameLength": 3,
			"placeholderPattern": "\\{\\{(ticket-id|activity|name|missing-fields|notes|signature|template-url|documentation|links)\\}\\}"
		},
		"it": {
			"fallbackName": "collega",
			"email":{
